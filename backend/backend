from network.telemetry import TelemetrySimulator


# --------------------------------------------------
# Create Flask application
# --------------------------------------------------

app = Flask(__name__)

CORS(app)


# --------------------------------------------------
# Create NetPulse network
# --------------------------------------------------

network = create_network()

simulator = TelemetrySimulator(network)


# --------------------------------------------------
# Helper function
# --------------------------------------------------

def get_links():

    links = []

    for source, destination, data in network.edges(
        data=True
    ):

        links.append({

            "source": source,

            "destination": destination,

            "latency": data["latency"],

            "utilization": data["utilization"],

            "packet_loss": data["packet_loss"],

            "jitter": data["jitter"],

            "queue_length": data["queue_length"]

        })

    return links


# --------------------------------------------------
# Calculate Network Health
# --------------------------------------------------

def calculate_network_health(links):

    if not links:
        return 0

    average_latency = sum(
        link["latency"]
        for link in links
    ) / len(links)

    average_utilization = sum(
        link["utilization"]
        for link in links
    ) / len(links)

    average_packet_loss = sum(
        link["packet_loss"]
        for link in links
    ) / len(links)

    average_jitter = sum(
        link["jitter"]
        for link in links
    ) / len(links)

    average_queue = sum(
        link["queue_length"]
        for link in links
    ) / len(links)

    # ----------------------------------------------
    # Health calculation
    # ----------------------------------------------

    health = (
        100

        - (average_latency * 0.2)

        - (average_utilization * 0.3)

        - (average_packet_loss * 5)

        - (average_jitter * 0.5)

        - (average_queue * 0.2)
    )

    health = max(
        0,
        min(
            100,
            health
        )
    )

    return round(
        health,
        2
    )


