# ==================================================
# DASHBOARD
# ==================================================

@app.route("/api/dashboard")
def get_dashboard():

    # ----------------------------------------------
    # Generate fresh telemetry
    # ----------------------------------------------

    simulator.update_all_links()

    # ----------------------------------------------
    # Get current network links
    # ----------------------------------------------

    links = get_links()

    # ----------------------------------------------
    # Calculate averages
    # ----------------------------------------------

    if links:

        average_latency = sum(
            link["latency"]
            for link in links
        ) / len(links)

        average_utilization = sum(
            link["utilization"]
            for link in links
        ) / len(links)

        average_packet_loss = sum(
            link["packet_loss"]
            for link in links
        ) / len(links)

        average_jitter = sum(
            link["jitter"]
            for link in links
        ) / len(links)

        average_queue_length = sum(
            link["queue_length"]
            for link in links
        ) / len(links)

    else:

        average_latency = 0

        average_utilization = 0

        average_packet_loss = 0

        average_jitter = 0

        average_queue_length = 0

    # ----------------------------------------------
    # Network health
    # ----------------------------------------------

    health = calculate_network_health(
        links
    )

    # ----------------------------------------------
    # Anomaly score
    #
    # Higher utilization means greater risk.
    # ----------------------------------------------

    anomaly_score = round(

        min(
            1,

            max(
                0,

                (
                    average_utilization - 50
                ) / 50
            )
        ),

        2
    )

    # ----------------------------------------------
    # Risk level
    # ----------------------------------------------

    if anomaly_score < 0.4:

        risk_level = "LOW"

    elif anomaly_score < 0.7:

        risk_level = "MODERATE"

    else:

        risk_level = "HIGH"

    # ----------------------------------------------
    # Dashboard response
    # ----------------------------------------------

    return jsonify({

        "project": "NetPulse",

        "status": (
            "healthy"
            if health >= 70
            else "warning"
        ),

        "network_health": health,

        "anomaly_score": anomaly_score,

        "risk_level": risk_level,

        "mean_time_to_predict": 4.2,

        "routers": len(
            network.nodes
        ),

        "links": len(
            network.edges
        ),

        "averages": {

            "latency": round(
                average_latency,
                2
            ),

            "utilization": round(
                average_utilization,
                2
            ),

            "packet_loss": round(
                average_packet_loss,
                2
            ),

            "jitter": round(
                average_jitter,
                2
            ),

            "queue_length": round(
                average_queue_length,
                2
            )

        },

        "telemetry": links

    })


